{
  "name": "arcade-collection",
  "version": "1.2.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSING.md",
  "type": "module",
  "description": "Arcade Collection: Barrel Quest 1.1.0 and Code Snake, original Canvas 2D games.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:prototypes": "node scripts/build-prototypes.mjs",
    "start:prototypes": "node scripts/serve-prototypes.mjs",
    "test:snake": "npm run build && node --test games/code-snake/tests/*.test.mjs",
    "test:snake:browser": "node games/code-snake/tests/browser.mjs",
    "test:artifact": "npm run build && node --test tests/production/*.test.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/serve.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": { "typescript": "7.0.2", "playwright": "1.62.1" }
}
